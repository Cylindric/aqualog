# NETWORK SETTINGS
PROXY_PORT_HTTP=80
PROXY_PORT_HTTPS=443
AUTH_PORT_HTTP=8000
BACKEND_PORT_HTTP=8001
FRONTEND_PORT_HTTP=8002
AUTH_PORT_HTTPS=8443

# CONTAINER VERSIONS
AUTHENTIK_TAG=2026.5.5
POSTGRES_TAG=16-alpine
CADDY_TAG=alpine
FRONTEND_TAG=latest
BACKEND_TAG=latest

# MAIL RELAY SETTINGS
SMTPFAST_API_KEY=

# AUTH SERVER SETTINGS
AUTHENTIK_EMAIL__FROM=email_from
AUTHENTIK_EMAIL__HOST=smtp-relay.brevo.com
AUTHENTIK_EMAIL__PASSWORD=xsmtp_password_here
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USERNAME=email_username
AUTHENTIK_ERROR_REPORTING__ENABLED=true
AUTHENTIK_POSTGRESQL__HOST=authdb
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=authdb_password_here
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_SECRET_KEY=authentik_secret_key_here

# COMMON SETTINGS
# AQUALOG_OAUTH_ISSUER_URL must match the externally-reachable URL Authentik stamps
# into the "iss" claim of issued tokens (used for token validation). The backend's
# docker-compose service overrides AQUALOG_OAUTH_DISCOVERY_URL separately so it can
# still reach Authentik over the internal docker network for JWKS discovery.
AQUALOG_OAUTH_ISSUER_URL=http://localhost:8000/application/o/aqualog/
AQUALOG_OAUTH_CLIENT_ID=aqualog

# BACKEND SETTINGS
AQUALOG_APP_ENV=dev
AQUALOG_API_VERSION=v1
AQUALOG_LOG_LEVEL=INFO
AQUALOG_DB_HOST=backenddb
AQUALOG_DB_NAME=aqualog
AQUALOG_DB_USER=aqualog
AQUALOG_DB_PORT=5432

# echo "AQUALOG_DB_PASSWORD=$(openssl rand -base64 36)"
AQUALOG_DB_PASSWORD='backenddb_password_here'

REQUESTS_CA_BUNDLE='/etc/ssl/certs/ca-certificates.crt'
SSL_CERT_FILE='/etc/ssl/certs/ca-certificates.crt'
CURL_CA_BUNDLE='/etc/ssl/certs/ca-certificates.crt'

# FRONTEND SETTINGS
AQUALOG_API_BASE_URL='http://localhost:8001'
AQUALOG_OIDC_REDIRECT_URI='http://localhost:8002/auth/callback'
AQUALOG_OIDC_POST_LOGOUT_REDIRECT_URI='http://localhost:8002'
AQUALOG_OIDC_SCOPE='openid profile email offline_access'

# PROXY SETTINGS
CLOUDFLARE_API_TOKEN=cloudflare_api_token_here

# TOOLS VARIABLES
AQUALOG_OAUTH_TOKEN_ENDPOINT=http://localhost:8000/application/o/token/
